function s = cell2txt(c)
if ischar(c), s = c; elseif isstring(c), s = char(c); else, s = '?'; end
end

function out = binref(refwl, col, ww, binw)
% average a reference spectrum over the pixel width of the data
out = zeros(size(ww));
for i = 1:numel(ww)
    mm = refwl >= ww(i) - binw / 2 & refwl <= ww(i) + binw / 2;
    if any(mm)
        out(i) = mean(col(mm));
    else
        out(i) = interp1(refwl, col, ww(i), 'linear', 'extrap');
    end
end
end

function c = chainconc(t, k)
% linear chain 1 -k(1)-> 2 -k(2)-> ... -> n+1; the last compartment does not decay.
% Compartment 1 starts with population 1 at t = 0.
k = k(:)';
n = numel(k);
for i = 2:n
    for j = 1:i-1
        if abs(k(i) - k(j)) < 1e-6 * k(j)
            k(i) = k(i) * (1 + 1e-5);
        end
    end
end
kk = [k, 0];
E  = exp(-t(:) * kk);
c  = zeros(numel(t), n + 1);
for j = 1:n+1
    pref = prod(kk(1:j-1));
    for i = 1:j
        den = 1;
        for l = 1:j
            if l ~= i
                den = den * (kk(l) - kk(i));
            end
        end
        c(:,j) = c(:,j) + pref / den * E(:,i);
    end
end
end

function [C, I] = designMatrix(t, logk, tau2, mdl)
% columns that get a free spectrum, and the population of the intermediate.
% logk = log rates of the chain (mdl.nChain values), then of the early components.
% With tau2, the intermediate is inserted after species mdl.intPos; it shares the
% free spectrum of the species that follows it.
k  = exp(logk(:)');
kc = k(1:mdl.nChain);
ke = k(mdl.nChain+1:end);
if isempty(tau2)
    C = chainconc(t, kc);
    I = zeros(numel(t), 1);
else
    p = mdl.intPos;
    c = chainconc(t, [kc(1:p), 1 / tau2, kc(p+1:end)]);
    I = c(:,p+1);
    C = [c(:,1:p), c(:,p+1) + c(:,p+2), c(:,p+3:end)];
end
if ~isempty(ke)
    C = [C, exp(-t(:) * ke)];
end
end

function [Rw, S, C, I] = residMatrix(logk, t, Y, w, Delta, tau2, mdl)
% weighted residual matrix; the species spectra S are solved linearly
[C, I] = designMatrix(t, logk, tau2, mdl);
Yc = Y - I * Delta;
S  = C \ Yc;
Rw = (Yc - C * S) .* w;
end

function r = residVector(logk, t, Y, w, Delta, tau2, mdl)
Rw = residMatrix(logk, t, Y, w, Delta, tau2, mdl);
r  = Rw(:);
end

function [p, chi2] = fitmodel(t, Y, w, Delta, tau2, p0, lo, hi, mdl)
fun = @(q) residVector(q, t, Y, w, Delta, tau2, mdl);
[p, chi2] = lmfit(fun, p0, lo, hi);
end

function [p, f] = lmfit(fun, p0, lo, hi)
% Levenberg-Marquardt with forward-difference Jacobian and box limits
lo = lo(:); hi = hi(:);
p  = min(max(p0(:), lo), hi);
r  = fun(p);
f  = r' * r;
lam = 1e-3;
np  = numel(p);
for it = 1:60
    J = zeros(numel(r), np);
    for j = 1:np
        dp = zeros(np, 1);
        dp(j) = 1e-6 * max(1, abs(p(j)));
        J(:,j) = (fun(p + dp) - r) / dp(j);
    end
    g = J' * r;
    H = J' * J;
    improved = false;
    rel = 0;
    for inner = 1:12
        step = -(H + lam * diag(diag(H))) \ g;
        step = min(max(step, -1), 1);
        pn = min(max(p + step, lo), hi);
        rn = fun(pn);
        fn = rn' * rn;
        if fn < f
            improved = true;
            rel = (f - fn) / f;
            p = pn; r = rn; f = fn;
            lam = max(lam / 5, 1e-9);
            break
        end
        lam = lam * 5;
    end
    if ~improved || rel < 1e-9
        break
    end
end
end

function [p, chi2, w, S, C, Rw] = nullfit(t, Y, sd, tau0, mdl)
% null model with three rounds of re-weighting from the residual scatter per wavelength
[nt, nl] = size(Y);
Z = zeros(1, nl);
w = 1 ./ sd;
p = log(1 ./ tau0(:));
lo = -inf(size(p)); hi = inf(size(p));
for it = 1:4
    [p, chi2] = fitmodel(t, Y, w, Z, [], p, lo, hi, mdl);
    [Rw, S, C] = residMatrix(p, t, Y, w, Z, [], mdl);
    if it < 4
        w = w ./ sqrt(mean(Rw.^2, 1) * nt / (nt - size(C, 2) - numel(p) / nl));
    end
end
end

function [pk, tpk, lateRatio] = intStats(kc, tau2, p)
% intermediate inserted after species p of the chain with rates kc:
% peak population, time of the peak, and the ratio intermediate / preceding species
% at the time when the preceding species has dropped to 0.1 % of its maximum
kc = kc(:)';
tg = [0, logspace(-3, log10(50 * max(1 ./ kc(1:p)) + 50 * tau2), 4000)]';
c  = chainconc(tg, [kc(1:p), 1 / tau2, kc(p+1:end)]);
[pk, ipk] = max(c(:,p+1));
tpk  = tg(ipk);
prev = c(:,p);
il   = find(prev > 1e-3 * max(prev), 1, 'last');
lateRatio = c(il,p+1) / prev(il);
end

function grp = noisegroups(t, edges)
% group number of every delay; noise is resampled within groups
grp = ones(numel(t), 1);
for i = 1:numel(edges)
    grp = grp + (t(:) >= edges(i));
end
end

function N = drawnoise(noiseRows, grp)
% resample whole residual spectra (keeps the spectral correlation), random sign.
% Delays are exchanged only within their group.
nt = size(noiseRows, 1);
ug = unique(grp);
if numel(ug) == 1
    idx = randi(nt, nt, 1);
else
    idx = zeros(nt, 1);
    for g = 1:numel(ug)
        mem = find(grp == ug(g));
        idx(mem) = mem(randi(numel(mem), numel(mem), 1));
    end
end
sg = 2 * (rand(nt, 1) > 0.5) - 1;
N  = noiseRows(idx, :) .* sg;
end

function [out, s1, cl] = bootstats(Yb, P, tauTrue)
% detection statistic T = chi2(null) - min over tau2 of chi2(with intermediate)
% s1 = spectrum of the species in front of the intermediate, cl = [cL, final radical]
% from the spectrum of the species behind it
Z = zeros(1, size(Yb, 2));
[p0, c0] = fitmodel(P.t, Yb, P.w, Z, [], P.pN, -inf(size(P.pN)), inf(size(P.pN)), P.mdl);
best = inf;
for g = 1:numel(P.grid)
    [~, c1] = fitmodel(P.t, Yb, P.w, P.Delta, P.grid(g), p0, P.lo, P.hi, P.mdl);
    best = min(best, c1);
end
E = NaN;
if ~isempty(tauTrue)
    [~, ct] = fitmodel(P.t, Yb, P.w, P.Delta, tauTrue, p0, P.lo, P.hi, P.mdl);
    E = ct - min([c0, best, ct]);
end
[~, Sb] = residMatrix(p0, P.t, Yb, P.w, Z, [], P.mdl);
ip = P.mdl.intPos;
Dw = P.Delta .* P.w;
rproj = ((Sb(ip,:) - P.S(ip,:)) .* P.w) * Dw' / (Dw * Dw');
out = [c0 - best, E, rproj, 1 ./ exp(p0(:)')];
if nargout > 1
    s1 = Sb(ip,:);
end
if nargout > 2
    xb = lsqnonneg(P.Bw, (Sb(ip+1,P.mk) .* P.w(P.mk))');
    cl = xb(:)';
end
end

function q = quantLinear(x, pr)
% quantile with linear interpolation (no toolbox needed)
x = sort(x(:));
n = numel(x);
pos = (n - 1) * pr + 1;
a = floor(pos); b = ceil(pos);
q = x(a) + (x(b) - x(a)) * (pos - a);
end

function q = quantCols(X, pr)
% quantile of every column
q = zeros(1, size(X, 2));
for j = 1:size(X, 2)
    q(j) = quantLinear(X(:,j), pr);
end
end

function [lo, hi] = wilson(p, n, z)
% Wilson score interval for a proportion p observed in n trials
den = 1 + z^2 / n;
cen = (p + z^2 / (2 * n)) / den;
hw  = z * sqrt(p .* (1 - p) / n + z^2 / (4 * n^2)) / den;
lo  = max(cen - hw, 0);
hi  = min(cen + hw, 1);
end

function x0 = interpCross(x, y, level)
% first x at which y reaches the level (linear interpolation); NaN if it never does
x0 = NaN;
i = find(y >= level, 1, 'first');
if isempty(i)
    return
end
if i == 1
    x0 = x(1);
    return
end
f  = (level - y(i-1)) / (y(i) - y(i-1));
x0 = x(i-1) + f * (x(i) - x(i-1));
end

function [tauEx, popEx, allAbove] = crossProfile(prof, thr)
% first tau2 of the profile scan at which dchi2 exceeds the threshold
tauEx = NaN; popEx = NaN; allAbove = false;
ie = find(prof(:,2) > thr, 1, 'first');
if isempty(ie) || ie == 1
    return
end
f = (thr - prof(ie-1,2)) / (prof(ie,2) - prof(ie-1,2));
tauEx = exp(log(prof(ie-1,1)) + f * (log(prof(ie,1)) - log(prof(ie-1,1))));
popEx = interp1(log(prof(:,1)), prof(:,4), log(tauEx));
allAbove = all(prof(ie:end,2) > thr);
end


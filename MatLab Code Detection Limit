%% tyr_intermediate_limit_v4_1.m 
% Detection limit for a hidden TyrOH.+ hopping intermediate in transient-absorption data
% -------------------------------------------------------------------------------------
% Question: an electron-transfer step shows no resolvable rise lag. How large could a
% sequential intermediate between two states be and still go unnoticed?
%
% Model
%   Chain:   species 1 (FAD*) -> species 2 -> ... -> last species (does not decay).
%            All species spectra are free, the lifetimes are fitted (cfg.tau0).
%   Early:   optional extra components that decay in parallel with free spectra and
%            lifetimes (cfg.tauEarly), meant for early dynamics when the
%            window starts near time zero.
%   Tested:  an intermediate I between species cfg.intPos and cfg.intPos+1. Its
%            spectrum is tied to the species that follows it:
%               S_I = S_following + cL*eps(intermediate radical) - cFin*eps(final radical)
%            cL and cFin are read from the spectrum of that following species.
%
% Steps
%   1. Fit without intermediate.   2. cL and tied spectrum.   3./4. Profile scan of the
%   intermediate lifetime tau2 on the measured data.   5. Bootstrap: false-alarm
%   threshold, detection probability per injected tau2, confidence intervals.
%   6. Simulated traces and concentration profiles.   7. Optional comparison with a
%   reference sample.   8. Results as matrices (cfg.resultsFile, CSV).   9. Figures.
%
% 
%   The .ana created for cross validation using OPTIMUS file has the TAVIS layout: 
%   (%FILENAME, %DATATYPE, %NUMBERSCANS, %TIMESCALE,
%   %TIMELIST, %WAVELENGTHLIST, %INTENSITYMATRIX). 
%   Optionally the measured delays before
%   cfg.tmin are put in front, so the file has the full time axis.
%
%   cfg.anaExport   writes one simulated data set (fitted model + injected intermediate +
%                   resampled noise) as an .ana text file, by default at the detection limit.
%
% 
%   cfg.intPos      puts the intermediate between other states (1 = as before).
%   cfg.tauEarly    adds one or two early components; use with a small cfg.tmin.
%   cfg.noiseEdges  keeps early and late noise apart in the bootstrap.
%
% Read this before starting near time zero
%   - No instrument response is modelled. Keep cfg.tmin a few IRF widths above zero
%     (for example 0.2 ps).
%   - A free early component swallows the rise of an intermediate with a similar
%     lifetime. 
%   - With an early window, lower cfg.bootGrid and cfg.tauInject, for example
%     cfg.bootGrid = logspace(log10(0.15), log10(6), 14) and
%     cfg.tauInject = [0.3 0.5 0.8 1.0 1.2 1.5 1.8] are required. Always
%     check bootGrid vs tauInject and match them to the injection scheme.
%
% Requirements: MATLAB R2019a or newer, no toolboxes.
% Units: time in ps, wavelength in nm, spectra in mOD, reference spectra in mM^-1 cm^-1,
%        cL in uM cm. Populations are calculated as fractions of the excited FAD.
%
% 

cfg = struct();

%% ------------------------------- settings ------------------------------------------
cfg.dataFile   = 'TA_dataWT.xlsx';   % rows = delays, columns = wavelengths of Dispersion and IRF corrected data 
cfg.refFile    = 'Spectral_references_from_literature_of_FAD_intermediates.xlsx'; %Table of epsilon of literature reference data/intermediates
cfg.toMilliOD  = 1e3;          % data are in OD -> factor to mOD (use 1 if already mOD)
cfg.tmin       = 0.3;          % ps, start of the fit window; no IRF is modelled, stay above ~0.2 ps
cfg.tPre       = -0.4;         % ps, delays before this are used for the first noise estimate
cfg.exclude    = [465 483];    % nm, one row per range to leave out (pump scatter)
cfg.tau0       = [7 30 1000];  % ps, start values of the chain lifetimes (FAD* decay first)
cfg.tauEarly   = [0.4 2];           % ps, start values of extra early components (parallel decays with
                               % free spectra): [] = none, 0.7 = one, [0.3 1.5] = two
cfg.intPos     = 1;            % the tested intermediate sits between species intPos and intPos+1
                               % (1 = between FAD* and its product, 2 = between species 2 and 3)
cfg.noiseEdges = [];           % ps, the bootstrap resamples noise only within the delay ranges
                               % separated by these edges; set 3 when the window starts before 3 ps

% columns of the reference sheet (1 = wavelength)
cfg.colRed     = 2;            % FAD.-
cfg.colOx      = 3;            % FADox
cfg.colFinal   = 5;            % TrpH.+   (radical of the final state)
cfg.colInt     = 8;            % TyrOH.+  (radical of the intermediate); 6 = neutral TyrO.

cfg.fitRange   = [380 670];    % nm, range used to estimate cL from the spectrum of P
cfg.cL         = [];           % uM cm; [] = estimate from the data
cfg.trpMode    = 'fitted';     % 'fitted'  : TrpH.+ amount as found in the spectrum of P
                               % 'oneToOne': one TrpH.+ per FAD.- with the
                               % literature epsilon
                               % 'none'    : use the TyrOH.+ band only
cfg.tau2grid   = logspace(log10(0.05), log10(6), 43);   % ps, profile scan
cfg.bound      = 3;            % null lifetimes may change by at most this factor in the scan (e.g. to compensate the injected lifetime)

cfg.nBoot0     = 400;          % bootstrap replicates without intermediate
cfg.nBoot1     = 150;          % replicates per injected lifetime
cfg.bootGrid   = logspace(log10(0.3), log10(6), 14);    % ps, tau2 grid inside the bootstrap
cfg.tauInject  = [0.6 0.8 1.0 1.2 1.4 1.6 1.8 2.0 2.5 3.0];   % ps
cfg.seed       = 1;
cfg.ciLevel    = 0.95;         % level of all confidence intervals

% traces and concentration profiles 
cfg.traceWl    = [400 450 550 580];   % nm, the nearest kept pixel is used
cfg.traceTmax  = 100;          % ps, right end of the time axis in the trace figures
cfg.concTmax   = 200;          % ps, end of the concentration profiles (they start at 0)

% optional reference sample without TyrOH.+ (same file layout as cfg.dataFile)
cfg.refDataFile = 'TA_data_refnoTyrOH(Y-F).xlsx';          %  '' = skip part 7
cfg.refTau0     = [15 30 1000];% ps, start values for that sample
cfg.refTauEarly = [];          % ps, early components of that sample; [] = same as cfg.tauEarly
cfg.refIntPos   = [];          % position in the reference chain; [] = same as cfg.intPos
cfg.cmpRange    = [380 660];   % nm, range for the comparison of the FAD* spectra
cfg.nBootCmp    = 200;

% output and export of results
cfg.resultsFile = 'results.mat';        % all results as plain matrices
cfg.exportCsv   = true;                 % the same matrices as CSV files with headers
cfg.exportDir   = 'tyr_limit_export';   % folder for CSV files and figures
cfg.saveFigures = true;                 % PNG files of all figures

% simulated data set with injected intermediate, written as .ana (TAVIS) file;
% values in the units of cfg.dataFile (OD), one row per delay
cfg.anaExport      = true;
cfg.anaFile        = 'simulated_injection.ana';
cfg.anaTau         = [];        % ps; [] = detection limit (95 % detection probability)
cfg.anaNumberScans = 1;         % value written in %NUMBERSCANS
cfg.anaDigits      = 5;         % significant digits of all numbers (5 as in the measured files)
cfg.anaIncludeEarly = false;    % true = measured delays before cfg.tmin are put in front
                                % (unchanged measurement there, simulation from cfg.tmin on)
cfg.anaSeed        = [];        % [] = continue the random sequence; a number = fixed noise draw
cfg.anaNoiseFree   = true;      % also write the same data without noise (_noisefree.ana)

rng(cfg.seed);
aLev = 1 - cfg.ciLevel;
zc   = sqrt(2) * erfinv(cfg.ciLevel);   % 1.96 for 95 %

%% ------------------------------- load ----------------------------------------------
[t, wl, A] = readta(cfg.dataFile, cfg.toMilliOD);
R = readref(cfg.refFile);
try
    hdr = readcell(cfg.refFile, 'Range', 'A1:J1');
    fprintf('Reference columns used: FAD.- = "%s", FADox = "%s", final = "%s", intermediate = "%s"\n', ...
        cell2txt(hdr{cfg.colRed}), cell2txt(hdr{cfg.colOx}), cell2txt(hdr{cfg.colFinal}), cell2txt(hdr{cfg.colInt}));
catch
    fprintf('Reference columns used (by number): %d %d %d %d\n', cfg.colRed, cfg.colOx, cfg.colFinal, cfg.colInt);
end

keep = true(size(wl));
for i = 1:size(cfg.exclude, 1)
    keep = keep & ~(wl >= cfg.exclude(i,1) & wl <= cfg.exclude(i,2));
end
sd0 = std(A(t < cfg.tPre, keep), 0, 1);
if any(sd0 == 0) || any(isnan(sd0))
    error('A kept wavelength has zero or undefined noise before time zero. Add it to cfg.exclude.');
end
m  = t >= cfg.tmin;
tt = t(m);                 % nt x 1
ww = wl(keep);             % 1 x nl
Y  = A(m, keep);           % nt x nl
[nt, nl] = size(Y);
Z  = zeros(1, nl);
fprintf('Fit window: %.2f to %.0f ps (%d delays), %d wavelengths from %.0f to %.0f nm\n', ...
    tt(1), tt(end), nt, nl, ww(1), ww(end));

mdl = struct('nChain', numel(cfg.tau0), 'nEarly', numel(cfg.tauEarly), 'intPos', cfg.intPos);
if cfg.intPos < 1 || cfg.intPos > mdl.nChain || cfg.intPos ~= round(cfg.intPos)
    error('cfg.intPos must be a whole number between 1 and the number of lifetimes in cfg.tau0.');
end
ip  = cfg.intPos;                      % species in front of the intermediate
nCh = mdl.nChain;
grp = noisegroups(tt, cfg.noiseEdges); % delay ranges for the noise resampling
if ip == 1
    precName = 'FADstar';  precLabel = 'FAD*';
else
    precName = sprintf('species%d', ip);  precLabel = sprintf('species %d', ip);
end

%% ------------------------------- 1. null model -------------------------------------
[pN, chiN, w, S, C, Rw] = nullfit(tt, Y, sd0, [cfg.tau0(:); cfg.tauEarly(:)]', mdl);
dof = numel(Y) - numel(pN) - numel(S);
tauN = 1 ./ exp(pN(:)');               % chain lifetimes first, then the early components
nRate = numel(pN);
fprintf('\nModel without intermediate: chain of %d species', nCh + 1);
if mdl.nEarly > 0, fprintf(' plus %d early component(s)', mdl.nEarly); end
fprintf('\n  chain lifetimes: %s ps\n', sprintf('%.2f  ', tauN(1:nCh)));
if mdl.nEarly > 0, fprintf('  early lifetimes: %s ps\n', sprintf('%.2f  ', tauN(nCh+1:end))); end
fprintf('  intermediate tested between species %d and %d\n', ip, ip + 1);
fprintf('  chi2 = %.0f for %d degrees of freedom (weights are rescaled so that this is ~1 per point)\n', chiN, dof);
fprintf('  median noise per point, 410-620 nm: %.3f mOD\n', median(1 ./ w(ww >= 410 & ww <= 620)));

%% ------------------------------- 2. cL and tied spectrum ---------------------------
binw = median(diff(wl));
eRed = binref(R(:,1), R(:,cfg.colRed),   ww, binw);
eOx  = binref(R(:,1), R(:,cfg.colOx),    ww, binw);
eFin = binref(R(:,1), R(:,cfg.colFinal), ww, binw);
eInt = binref(R(:,1), R(:,cfg.colInt),   ww, binw);
mk = ww >= cfg.fitRange(1) & ww <= cfg.fitRange(2);
B  = [(eRed(mk) - eOx(mk))', eFin(mk)'];
Bw = B .* w(mk)';
x  = lsqnonneg(Bw, (S(ip+1,mk) .* w(mk))');   % species that follows the intermediate
if isempty(cfg.cL), cL = x(1); else, cL = cfg.cL; end
switch cfg.trpMode
    case 'fitted',   cFin = x(2);
    case 'oneToOne', cFin = cL;
    case 'none',     cFin = 0;
    otherwise, error('Unknown cfg.trpMode');
end
Delta = cL * eInt - cFin * eFin;          % 1 x nl, mOD per unit population of I
[~, iPk] = max(eInt);
fprintf('\nFAD.- in species %d: cL = %.3f uM cm; final radical there: %.3f uM cm (%.0f %% of cL)\n', ip + 1, cL, x(2), 100 * x(2) / cL); %calculates the amount of reduced FAD after ES decay
fprintf('  A full population of the intermediate would add %.2f mOD at %.0f nm\n', Delta(iPk), ww(iPk)); %calculates the maximum signal a injected intermedate could reach when populated by FAD oxidation and no intrinsic decay 

%% ------------------------------- 3./4. profile scan --------------------------------
lo = pN - log(cfg.bound);
hi = pN + log(cfg.bound);
ng = numel(cfg.tau2grid);
prof = zeros(ng, 4);                      % tau2, dchi2, lifetime of the preceding species, peak population in sequential scheme
p = pN;
for g = 1:ng
    tau2 = cfg.tau2grid(g);
    [p1, c1] = fitmodel(tt, Y, w, Delta, tau2, p,  lo, hi, mdl);
    [p2, c2] = fitmodel(tt, Y, w, Delta, tau2, pN, lo, hi, mdl);
    if c1 <= c2, p = p1; c = c1; else, p = p2; c = c2; end
    prof(g,:) = [tau2, c - chiN, 1 / exp(p(ip)), intStats(exp(p(1:nCh))', tau2, ip)];
end
[dmin, imin] = min(prof(:,2));
fprintf('\nProfile scan: smallest dchi2 = %.1f at tau2 = %.2f ps\n', dmin, prof(imin,1));

%% ------------------------------- 5. bootstrap --------------------------------------
P = struct('t', tt, 'w', w, 'Delta', Delta, 'pN', pN, 'lo', lo, 'hi', hi, ...
           'grid', cfg.bootGrid, 'S', S, 'Bw', Bw, 'mk', mk, 'mdl', mdl);
noiseRows = (Rw ./ w) * sqrt(numel(Y) / dof);
M0 = C * S;

fprintf('\nBootstrap without intermediate (%d replicates) ', cfg.nBoot0);
H0     = zeros(cfg.nBoot0, 3 + nRate);    % T, E (unused here), r projection, lifetimes
S1boot = zeros(cfg.nBoot0, nl);           % spectrum of the preceding species in each replicate
cLboot = zeros(cfg.nBoot0, 2);            % cL and final radical of each replicate
for b = 1:cfg.nBoot0
    [H0(b,:), S1boot(b,:), cLboot(b,:)] = bootstats(M0 + drawnoise(noiseRows, grp), P, []);
    if mod(b, 50) == 0, fprintf('.'); end
end
fprintf('\n');
Tcrit = quantLinear(H0(:,1), 0.95);
obs   = bootstats(Y, P, []);
Tobs  = obs(1);
pval  = mean(H0(:,1) >= Tobs);
sdTau = std(H0(:,4:end), 0, 1);
sdR   = std(H0(:,3));

k  = exp(pN(:)');
kc = k(1:nCh);                            % chain rates
nq = numel(cfg.tauInject);
T1 = zeros(cfg.nBoot1, nq);               % detection statistic of every injected replicate
E1 = zeros(cfg.nBoot1, nq);               % dchi2 at the true tau2
fprintf('Bootstrap with injected intermediate (%d replicates each)\n', cfg.nBoot1);
for q = 1:nq
    tau = cfg.tauInject(q);
    [C1, I1] = designMatrix(tt, pN, tau, mdl);
    M1  = C1 * S + I1 * Delta;
    for b = 1:cfg.nBoot1
        h = bootstats(M1 + drawnoise(noiseRows, grp), P, tau);
        T1(b,q) = h(1);
        E1(b,q) = h(2);
    end
    fprintf('  tau2 = %4.1f ps   peak population %5.1f %%   detected in %5.1f %%\n', ...
        tau, 100 * intStats(kc, tau, ip), 100 * mean(T1(:,q) > Tcrit));
end

%% ------------------------------- 5b. confidence intervals --------------------------
% lifetimes, cL and the spectrum of the preceding species: percentiles of the bootstrap replicates
ciTau  = [quantCols(H0(:,4:end), aLev / 2); quantCols(H0(:,4:end), 1 - aLev / 2)];
ciCL   = [quantCols(cLboot, aLev / 2); quantCols(cLboot, 1 - aLev / 2)];
sdCL   = std(cLboot, 0, 1);
sdS1   = std(S1boot, 0, 1);
ciS1   = [quantCols(S1boot, aLev / 2); quantCols(S1boot, 1 - aLev / 2)];

% false-alarm threshold: interval of the 95 % quantile from its rank uncertainty
seQ     = sqrt(0.95 * 0.05 / cfg.nBoot0);
TcritLo = quantLinear(H0(:,1), max(0, 0.95 - zc * seQ));
TcritHi = quantLinear(H0(:,1), min(1, 0.95 + zc * seQ));

% detection probability: Wilson interval, widened by the uncertainty of the threshold
pw = zeros(nq, 8);    % tau2, peak pop, late ratio I/preceding, detection prob, ciLow, ciHigh, e95, expected dchi2
for q = 1:nq
    tau  = cfg.tauInject(q);
    pHat = mean(T1(:,q) > Tcrit);
    pLo  = wilson(mean(T1(:,q) > TcritHi), cfg.nBoot1, zc);
    [~, pHi] = wilson(mean(T1(:,q) > TcritLo), cfg.nBoot1, zc);
    [pkq, ~, lrq] = intStats(kc, tau, ip);
    pw(q,1:7) = [tau, pkq, lrq, pHat, min(pLo, pHat), max(pHi, pHat), quantLinear(E1(:,q), 0.95)];
end
thrEx   = max(pw(:,7));
thrExLo = min(pw(:,7));

% detection limit (95 % detection probability) with interval
tauDet   = interpCross(pw(:,1), pw(:,4), 0.95);
tauDetLo = interpCross(pw(:,1), pw(:,6), 0.95);     % optimistic end
tauDetHi = interpCross(pw(:,1), pw(:,5), 0.95);     % pessimistic end
popDet = NaN; popDetLo = NaN; popDetHi = NaN;
if ~isnan(tauDet),   popDet   = intStats(kc, tauDet, ip);   end
if ~isnan(tauDetLo), popDetLo = intStats(kc, tauDetLo, ip); end
if ~isnan(tauDetHi), popDetHi = intStats(kc, tauDetHi, ip); end

% exclusion from the measured data: crossing of the calibrated threshold
[tauEx, popEx, allAbove] = crossProfile(prof, thrEx);       % conservative threshold
[tauExLo, popExLo]       = crossProfile(prof, thrExLo);     % smallest calibrated threshold

%% ------------------------------- 6. simulated traces and concentrations ------------
% 6a. noise-free TA with an injected intermediate, refitted WITHOUT intermediate.
%     simAdded      = what the injection changes in the TA
%     simUnabsorbed = what is left after the free spectra and lifetimes have adapted;
%                     only this part can be detected
[~, ixTr] = min(abs(ww(:) - cfg.traceWl(:)'), [], 1);   % nearest kept pixel
nTr = numel(ixTr);
simInjected  = zeros(nt, nl, nq);
simNullRefit = zeros(nt, nl, nq);
forcedFit    = zeros(nt, nl, nq);     % measured data fitted with an intermediate forced at tau2
refitTau     = zeros(nq, nRate);
forcedDchi2  = zeros(nq, 1);
for q = 1:nq
    tau = cfg.tauInject(q);
    [C1, I1] = designMatrix(tt, pN, tau, mdl);
    M1  = C1 * S + I1 * Delta;
    [pq, chq] = fitmodel(tt, M1, w, Z, [], pN, -inf(size(pN)), inf(size(pN)), mdl);
    [~, Sq, Cq] = residMatrix(pq, tt, M1, w, Z, [], mdl);
    simInjected(:,:,q)  = M1;
    simNullRefit(:,:,q) = Cq * Sq;
    pw(q,8)             = chq;
    refitTau(q,:)       = 1 ./ exp(pq(:)');
    [pf, chf] = fitmodel(tt, Y, w, Delta, tau, pN, lo, hi, mdl);
    [~, Sf, Cf, Iforced] = residMatrix(pf, tt, Y, w, Delta, tau, mdl);
    forcedFit(:,:,q) = Cf * Sf + Iforced * Delta;
    forcedDchi2(q)   = chf - chiN;
end
simAdded      = simInjected - M0;
simUnabsorbed = simInjected - simNullRefit;
fprintf('\nTrace pixels: %s nm\n', sprintf('%.1f  ', ww(ixTr)));
fprintf('Expected dchi2 of the injected intermediates (no noise): %s\n', sprintf('%.1f  ', pw(:,8)));

% 6b. concentration profiles from time zero (fractions of the excited FAD)
concTime = [0, logspace(-2, log10(cfg.concTmax), 300)]';
nTc      = numel(concTime);
concNull = chainconc(concTime, kc);               % chain species without intermediate
nComp    = nCh + 2;
concChain = zeros(nTc, nComp, nq);                % chain with the intermediate in column ip+1
concI = zeros(nTc, nq); concP = zeros(nTc, nq); concRatio = zeros(nTc, nq);
concSummary = zeros(nq, 6);   % tau2, peak pop, time of peak, I at tmin, I/preceding at tmin, late I/preceding
for q = 1:nq
    tau = cfg.tauInject(q);
    c = chainconc(concTime, [kc(1:ip), 1 / tau, kc(ip+1:end)]);
    concChain(:,:,q) = c;
    concI(:,q) = c(:,ip+1);
    concP(:,q) = c(:,ip+2);                       % species that follows the intermediate
    concRatio(:,q) = c(:,ip+1) ./ max(c(:,ip), realmin);
    cm = chainconc(tt(1), [kc(1:ip), 1 / tau, kc(ip+1:end)]);
    [pkq, tpq, lrq] = intStats(kc, tau, ip);
    concSummary(q,:) = [tau, pkq, tpq, cm(ip+1), cm(ip+1) / max(cm(ip), realmin), lrq];
end
concIscan = zeros(nTc, ng);                       % intermediate population for the profile-scan grid
for g = 1:ng
    c = chainconc(concTime, [kc(1:ip), 1 / cfg.tau2grid(g), kc(ip+1:end)]);
    concIscan(:,g) = c(:,ip+1);
end
concEarly = zeros(nTc, mdl.nEarly);               % early components, each starting at 1
for i = 1:mdl.nEarly
    concEarly(:,i) = exp(-concTime * k(nCh+i));
end

%% ------------------------------- 7. optional: reference sample ----------------------
hasRef = ~isempty(cfg.refDataFile);
if hasRef
    [t2, wl2, A2] = readta(cfg.refDataFile, cfg.toMilliOD);
    if numel(wl2) ~= numel(wl) || max(abs(wl2 - wl)) > 0.5
        A2 = interp1(wl2(:), A2', wl(:))';        % onto the wavelength grid of the main data
    end
    sd2 = std(A2(t2 < cfg.tPre, keep), 0, 1);
    m2  = t2 >= cfg.tmin;
    tt2 = t2(m2);  Y2 = A2(m2, keep);
    if any(isnan(Y2(:))) || any(sd2 == 0) || any(isnan(sd2))
        error('Reference sample: wavelengths do not cover the main data, or a pixel has no noise estimate.');
    end
    refEarly = cfg.refTauEarly;  if isempty(refEarly), refEarly = cfg.tauEarly; end
    ipR = cfg.refIntPos;         if isempty(ipR), ipR = ip; end
    mdlR = struct('nChain', numel(cfg.refTau0), 'nEarly', numel(refEarly), 'intPos', ipR);
    if ipR < 1 || ipR > mdlR.nChain, error('cfg.refIntPos does not fit cfg.refTau0.'); end
    grpR = noisegroups(tt2, cfg.noiseEdges);
    [pR, ~, wR, SR, CR, RwR] = nullfit(tt2, Y2, sd2, [cfg.refTau0(:); refEarly(:)]', mdlR);
    tauRef = 1 ./ exp(pR(:)');
    mc = ww >= cfg.cmpRange(1) & ww <= cfg.cmpRange(2);
    Bc = [SR(ipR,mc)', Delta(mc)'] .* w(mc)';
    co = Bc \ (S(ip,mc) .* w(mc))';            % co(1) = scale a, co(2) = share r
    resC = (S(ip,mc) - co(1) * SR(ipR,mc) - co(2) * Delta(mc)) .* w(mc);
    % noise: resample both data sets
    dofR = numel(Y2) - numel(pR) - numel(SR);
    noiseR = (RwR ./ wR) * sqrt(numel(Y2) / dofR);
    MR = CR * SR;  Z2 = zeros(1, nl);
    rb    = zeros(cfg.nBootCmp, 2);            % scale and r of every replicate
    rbres = zeros(cfg.nBootCmp, 1);
    SaB   = zeros(cfg.nBootCmp, nl);           % FAD* spectra of the replicates, main sample
    SbB   = zeros(cfg.nBootCmp, nl);           % reference sample
    for b = 1:cfg.nBootCmp
        Ya = M0 + drawnoise(noiseRows, grp);
        pa = fitmodel(tt,  Ya, w,  Z,  [], pN, -inf(size(pN)), inf(size(pN)), mdl);
        [~, Sa] = residMatrix(pa, tt, Ya, w, Z, [], mdl);
        Yb = MR + drawnoise(noiseR, grpR);
        pb = fitmodel(tt2, Yb, wR, Z2, [], pR, -inf(size(pR)), inf(size(pR)), mdlR);
        [~, Sb] = residMatrix(pb, tt2, Yb, wR, Z2, [], mdlR);
        cb = ([Sb(ipR,mc)', Delta(mc)'] .* w(mc)') \ (Sa(ip,mc) .* w(mc))';
        rb(b,:)  = cb(:)';
        rbres(b) = sqrt(mean(((Sa(ip,mc) - cb(1) * Sb(ipR,mc) - cb(2) * Delta(mc)) .* w(mc)).^2));
        SaB(b,:) = Sa(ip,:);
        SbB(b,:) = Sb(ipR,:);
    end
    sdA  = std(rb(:,1));
    sdRc = std(rb(:,2));
    devA = rb(:,1) - mean(rb(:,1));
    devR = rb(:,2) - mean(rb(:,2));
    aCI  = co(1) + [quantLinear(devA, aLev / 2), quantLinear(devA, 1 - aLev / 2)];
    rCI  = co(2) + [quantLinear(devR, aLev / 2), quantLinear(devR, 1 - aLev / 2)];
    zR   = co(2) / sdRc;
    % one-sided upper limits for r (a population cannot be negative)
    rUp        = max(co(2), 0) + quantLinear(devR, cfg.ciLevel);          % noise only
    rUpCaut    = abs(co(2)) + quantLinear(devR, cfg.ciLevel);             % offset counted as possible systematic error
    tauUp      = rUp * tauN(ip) / (1 + rUp);          % exact for ip = 1, approximate otherwise
    tauUpCaut  = rUpCaut * tauN(ip) / (1 + rUpCaut);
    popUp      = intStats(kc, tauUp, ip);
    popUpCaut  = intStats(kc, tauUpCaut, ip);
    resRatio   = sqrt(mean(resC.^2)) / median(rbres);
    % spectra with their noise per point
    cmpMain   = S(ip,:);
    cmpRef    = co(1) * SR(ipR,:);
    cmpDiff   = cmpMain - cmpRef;
    sdMain    = std(SaB, 0, 1);
    sdRefSc   = abs(co(1)) * std(SbB, 0, 1);
    sdDiff    = std(SaB - co(1) * SbB, 0, 1);
    cmpZ      = cmpDiff ./ sdDiff;             % difference in units of its noise
end

%% ------------------------------- 7b. simulated data set as .ana file ----------------
% One data set built exactly like those of the injection test: fitted model without
% intermediate + intermediate with lifetime tauAna + one resampled noise matrix.
% At the detection limit, 95 % of such data sets pass the test; this file is one of them
% or one of the 5 % that do not. The script tells you which.
anaWritten = false;
tauAna = cfg.anaTau;
if isempty(tauAna), tauAna = tauDet; end
if cfg.anaExport && isnan(tauAna)
    fprintf('\nNo .ana file written: the detection probability does not reach 95 %% within cfg.tauInject.\n');
    fprintf('Set cfg.anaTau to a lifetime in ps or extend cfg.tauInject.\n');
elseif cfg.anaExport
    if ~isempty(cfg.anaSeed), rng(cfg.anaSeed); end
    [Ca, Ia] = designMatrix(tt, pN, tauAna, mdl);
    anaClean = Ca * S + Ia * Delta;              % mOD, noise-free
    anaNoise = drawnoise(noiseRows, grp);        % same noise model as in the bootstrap
    anaData  = anaClean + anaNoise;
    hAna     = bootstats(anaData, P, tauAna);
    anaT     = hAna(1);
    anaPeak  = intStats(kc, tauAna, ip);
    % best trial lifetime for this data set (same search as in the test)
    [p0a, c0a] = fitmodel(tt, anaData, w, Z, [], pN, -inf(size(pN)), inf(size(pN)), mdl);
    chiA = zeros(numel(cfg.bootGrid), 1);
    for g = 1:numel(cfg.bootGrid)
        [~, chiA(g)] = fitmodel(tt, anaData, w, Delta, cfg.bootGrid(g), p0a, lo, hi, mdl);
    end
    [~, gBest] = min(chiA);
    anaTauBest = cfg.bootGrid(gBest);
    if cfg.anaIncludeEarly
        mEarly = t < tt(1);
        anaTime  = [t(mEarly); tt];
        anaOut   = [A(mEarly, keep); anaData] / cfg.toMilliOD;
        anaOutNF = [A(mEarly, keep); anaClean] / cfg.toMilliOD;
    else
        anaTime  = tt;
        anaOut   = anaData / cfg.toMilliOD;
        anaOutNF = anaClean / cfg.toMilliOD;
    end
    writeana(cfg.anaFile, anaTime, ww, anaOut, cfg.anaNumberScans, cfg.anaDigits);
    if cfg.anaNoiseFree
        [fp, fn] = fileparts(cfg.anaFile);
        writeana(fullfile(fp, [fn '_noisefree.ana']), anaTime, ww, anaOutNF, cfg.anaNumberScans, cfg.anaDigits);
    end
    anaWritten = true;
end

